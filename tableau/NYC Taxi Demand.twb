  <dashboards>
    <dashboard name="01 Demand overview" lock-updates="true">
      <style />
      <size maxheight="1000" minheight="1000" maxwidth="1500" minwidth="1500" sizing-mode="fixed" />
      <zones>
        <zone id="0" x="0" y="0" w="100000" h="100000" type-v2="layout-basic">
          <zone id="1" x="1800" y="1000" w="96000" h="6500" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="25" bold="true" fontcolor="#18384b">NYC yellow taxi demand: January 2026</run>
            </formatted-text>
          </zone>
          <zone id="2" x="1800" y="9000" w="96000" h="6500" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="18" bold="true" fontcolor="#18384b">3,517,775 eligible trips     $104.39M recorded payments     45.8% in the top 15 zones</run>
            </formatted-text>
          </zone>
          <zone id="3" x="1800" y="93000" w="96000" h="5000" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="11" bold="false" fontcolor="#18384b">Heatmap: darker means more pickups. Its averages include active days only. Recorded pickups do not measure unmet demand.</run>
            </formatted-text>
          </zone>
          <zone id="4" name="Daily Taxi Demand - January 2026" x="1500" y="19000" w="48000" h="32000">
            <layout-cache type-h="scalable" type-w="scalable" />
          </zone>
          <zone id="5" name="Avg Daily Trips by Pickup Hour - January 2026" x="50500" y="19000" w="48000" h="32000">
            <layout-cache type-h="scalable" type-w="scalable" />
          </zone>
          <zone id="6" name="Top 15 Pickup Zones by Trip - January 2026" x="1500" y="53000" w="41000" h="38000">
            <layout-cache type-h="scalable" type-w="scalable" />
          </zone>
          <zone id="7" name="Hourly Pickup Demand by Selected Zone - January 2026" x="43500" y="53000" w="55000" h="38000">
            <layout-cache type-h="scalable" type-w="scalable" />
          </zone>
        </zone>
      </zones>
      <simple-id uuid="{565F8E44-9CFF-4BD1-A867-357B7F3E0C57}" />
    </dashboard>
    <dashboard name="02 Coverage and airport decisions" lock-updates="true">
      <style />
      <size maxheight="1000" minheight="1000" maxwidth="1500" minwidth="1500" sizing-mode="fixed" />
      <zones>
        <zone id="0" x="0" y="0" w="100000" h="100000" type-v2="layout-basic">
          <zone id="1" x="1800" y="1000" w="96000" h="6500" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="25" bold="true" fontcolor="#18384b">Where should the fleet test different coverage?</run>
            </formatted-text>
          </zone>
          <zone id="2" x="1800" y="10500" w="96000" h="5000" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="14" bold="false" fontcolor="#18384b">Top five zones by monthly trips. Peak-hour averages below include all 31 calendar days.</run>
            </formatted-text>
          </zone>
          <zone id="3" x="1800" y="43000" w="96000" h="6000" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="14" bold="false" fontcolor="#18384b">Test shift overlaps near these peak windows. Check nearby supply and repositioning costs before moving drivers.</run>
            </formatted-text>
          </zone>
          <zone id="4" x="1800" y="49000" w="96000" h="4500" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="18" bold="true" fontcolor="#18384b">Airport payments and trip time</run>
            </formatted-text>
          </zone>
          <zone id="5" x="1800" y="74000" w="96000" h="6500" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="14" bold="false" fontcolor="#18384b">Higher airport payments come with longer trips. These figures omit waiting, empty return travel and operating costs.</run>
            </formatted-text>
          </zone>
          <zone id="6" x="1800" y="84000" w="96000" h="10000" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="16" bold="true" fontcolor="#18384b">Decision: approve a limited pilot using existing vehicles, subject to dispatch and driver availability. Validate January patterns against recent months first.</run>
            </formatted-text>
          </zone>
          <zone id="7" name="Priority pickup windows" x="1800" y="18000" w="96000" h="24000">
            <layout-cache type-h="scalable" type-w="scalable" />
          </zone>
          <zone id="8" name="Airport trip comparison" x="1800" y="54000" w="96000" h="18000">
            <layout-cache type-h="scalable" type-w="scalable" />
          </zone>
        </zone>
      </zones>
      <simple-id uuid="{33E3F072-B4DF-42C3-BB69-8A09D3B87B2C}" />
    </dashboard>
    <dashboard name="03 Pilot and measurement" lock-updates="true">
      <style />
      <size maxheight="1000" minheight="1000" maxwidth="1500" minwidth="1500" sizing-mode="fixed" />
      <zones>
        <zone id="0" x="0" y="0" w="100000" h="100000" type-v2="layout-basic">
          <zone id="1" x="1800" y="1000" w="96000" h="6500" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="25" bold="true" fontcolor="#18384b">A four-week pilot with a measurable business outcome</run>
            </formatted-text>
          </zone>
          <zone id="2" x="2000" y="13000" w="95000" h="9000" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="22" bold="true" fontcolor="#18384b">Goal: improve net earnings per driver working hour without worsening service coverage.</run>
            </formatted-text>
          </zone>
          <zone id="3" x="2000" y="26000" w="95000" h="18000" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="17" bold="false" fontcolor="#18384b">Pilot design
Operations selects comparable zone and shift groups. One group tests revised shift overlaps; the comparison group keeps its current schedule. Check weekday mix, weather and events.</run>
            </formatted-text>
          </zone>
          <zone id="4" x="2000" y="47000" w="95000" h="18000" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="17" bold="false" fontcolor="#18384b">Measurement
Primary: net earnings divided by all working hours. Supporting: trips per working hour and empty miles. Safeguard: passenger waiting time and coverage in comparison zones.</run>
            </formatted-text>
          </zone>
          <zone id="5" x="2000" y="68000" w="95000" h="16000" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="17" bold="false" fontcolor="#18384b">Decision gate
Agree an economically meaningful improvement threshold and minimum sample before launch. Expand only when the pilot clears that threshold and service safeguards hold.</run>
            </formatted-text>
          </zone>
          <zone id="6" x="2000" y="89000" w="95000" h="8000" type-v2="text" forceUpdate="true">
            <formatted-text>
              <run fontsize="12" bold="false" fontcolor="#18384b">Data needed: driver shifts, dispatch activity, waiting time, fuel and other costs. TLC trip records alone cannot demonstrate profit uplift. Source: NYC TLC, January 2026.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
      <simple-id uuid="{CE680631-EA05-42FE-BB8A-1F4F06C1EF64}" />
    </dashboard>
  </dashboards>
