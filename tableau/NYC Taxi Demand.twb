    <worksheet name="Priority pickup windows">
      <table>
        <view>
          <datasources>
            <datasource name="federated.priority_table" />
          </datasources>
          <datasource-dependencies datasource="federated.priority_table">
            <column caption="Priority zone" datatype="string" name="[Priority_zone]" role="dimension" type="nominal" />
            <column-instance column="[Priority_zone]" derivation="None" name="[none:Priority_zone:nk]" pivot="key" type="nominal" />
            <column caption="Peak hour" datatype="string" name="[Peak_hour]" role="dimension" type="nominal" />
            <column-instance column="[Peak_hour]" derivation="None" name="[none:Peak_hour:nk]" pivot="key" type="nominal" />
            <column caption="Pickups per day in peak hour" datatype="string" name="[Pickups_per_day_in_peak_hour]" role="dimension" type="nominal" />
            <column-instance column="[Pickups_per_day_in_peak_hour]" derivation="None" name="[none:Pickups_per_day_in_peak_hour:nk]" pivot="key" type="nominal" />
            <column caption="Monthly trip share" datatype="string" name="[Monthly_trip_share]" role="dimension" type="nominal" />
            <column-instance column="[Monthly_trip_share]" derivation="None" name="[none:Monthly_trip_share:nk]" pivot="key" type="nominal" />
            <column caption="Label" datatype="string" name="[Label]" role="dimension" type="nominal" />
            <column-instance column="[Label]" derivation="None" name="[none:Label:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[federated.priority_table].[none:Label:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>([federated.priority_table].[none:Priority_zone:nk] * [federated.priority_table].[none:Peak_hour:nk] * [federated.priority_table].[none:Pickups_per_day_in_peak_hour:nk] * [federated.priority_table].[none:Monthly_trip_share:nk])</rows>
        <cols />
      </table>
      <simple-id uuid="{7B5770DD-B6BB-4F88-BE76-BB36423ABA06}" />
    </worksheet>
    <worksheet name="Airport trip comparison">
      <table>
        <view>
          <datasources>
            <datasource name="federated.airport_table" />
          </datasources>
          <datasource-dependencies datasource="federated.airport_table">
            <column caption="Pickup area" datatype="string" name="[Pickup_area]" role="dimension" type="nominal" />
            <column-instance column="[Pickup_area]" derivation="None" name="[none:Pickup_area:nk]" pivot="key" type="nominal" />
            <column caption="January trips" datatype="string" name="[January_trips]" role="dimension" type="nominal" />
            <column-instance column="[January_trips]" derivation="None" name="[none:January_trips:nk]" pivot="key" type="nominal" />
            <column caption="Payment per trip USD" datatype="string" name="[Payment_per_trip_USD]" role="dimension" type="nominal" />
            <column-instance column="[Payment_per_trip_USD]" derivation="None" name="[none:Payment_per_trip_USD:nk]" pivot="key" type="nominal" />
            <column caption="Minutes per trip" datatype="string" name="[Minutes_per_trip]" role="dimension" type="nominal" />
            <column-instance column="[Minutes_per_trip]" derivation="None" name="[none:Minutes_per_trip:nk]" pivot="key" type="nominal" />
            <column caption="Label" datatype="string" name="[Label]" role="dimension" type="nominal" />
            <column-instance column="[Label]" derivation="None" name="[none:Label:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[federated.airport_table].[none:Label:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>([federated.airport_table].[none:Pickup_area:nk] * [federated.airport_table].[none:January_trips:nk] * [federated.airport_table].[none:Payment_per_trip_USD:nk] * [federated.airport_table].[none:Minutes_per_trip:nk])</rows>
        <cols />
      </table>
      <simple-id uuid="{29A734E6-C95E-4BDC-99C2-550D69437E3F}" />
    </worksheet>
